# ==============================================================================
# CreatorSpark — Environment Variables Example
# Copy this file to '.env' for local development. Never commit '.env' to git!
# ==============================================================================

# Django Secret Key (Generate a secure random string in production)
# Accepts either SECRET_KEY or DJANGO_SECRET_KEY
SECRET_KEY=django-insecure-your-local-dev-key-change-in-production
# DJANGO_SECRET_KEY=your-production-secret-key-here

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or domains)
# Local development default:
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,testserver
# Note: On Render, RENDER_EXTERNAL_HOSTNAME is automatically detected and added.

# CSRF Trusted Origins (Comma-separated URLs with scheme)
# Local development default:
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
# Example for Render production: CSRF_TRUSTED_ORIGINS=https://your-service-name.onrender.com

# Database Connection URL
# Leave empty or omit for local SQLite development (default: sqlite:///db.sqlite3)
# PostgreSQL Example for Render/Production (automatically provided by Render PostgreSQL):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# Production SSL Settings (Used when DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
